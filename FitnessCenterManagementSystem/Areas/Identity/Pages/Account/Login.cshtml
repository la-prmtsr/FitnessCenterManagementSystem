@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    //Layout = null; // Opsiyonel: Navbar'sız tam ekran için. İstersen kaldırabilirsin.
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container-fluid vh-100 bg-white">
    <div class="row h-100">
        <div class="col-md-6 col-lg-5 d-flex align-items-center justify-content-center order-2 order-md-1">
            <div class="w-100 p-4 p-md-5" style="max-width: 450px;">
                <div class="mb-5">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <h4 class="fw-bolder text-dark mb-4">CORE <span style="color: var(--core-lime);">36</span></h4>
                    </a>
                    <h1 class="fw-bold display-5 text-dark">Welcome <span class="fst-italic" style="color: var(--core-lime);">Back</span></h1>                    <p class="text-muted">Kaldığın yerden devam etmeye hazır mısın?</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control border-0 bg-light rounded-4" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-muted small">E-posta</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control border-0 bg-light rounded-4" placeholder="password" />
                        <label asp-for="Input.Password" class="text-muted small">Şifre</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label text-muted small" asp-for="Input.RememberMe">Beni Hatırla</label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small text-dark fw-bold">Şifremi unuttum</a>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-primary py-3 fw-bold shadow-lg">
                        GİRİŞ YAP
                    </button>

                    <div class="text-center mt-5">
                        <p class="text-muted small">Hesabın yok mu? <a asp-page="./Register" ... class="..." style="color: var(--core-dark); font-weight: 800; border-bottom: 2px solid var(--core-lime);">Hemen Kayıt Ol</a>></p>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-6 col-lg-7 d-none d-md-block p-3 order-1 order-md-2">
            <div class="h-100 w-100 rounded-5 overflow-hidden position-relative">
                <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2000"
                     class="w-100 h-100 shadow-lg" style="object-fit: cover;">
                <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-25"></div>
                <div class="position-absolute bottom-0 start-0 p-5 text-white">
                    <span class="badge bg-primary text-dark mb-3 px-3 py-2 rounded-pill fw-bold" style="background-color: var(--core-lime) !important;">MOTIVATION</span>
                    <h2 class="display-4 fw-bold italic">CONSISTENCY IS <span class="text-white border-bottom border-3">KEY</span></h2>
                </div>
            </div>
        </div>
    </div>
</div>















@* @page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container-fluid vh-100">
    <div class="row h-100">

        <div class="col-md-6 col-lg-5 d-flex align-items-center justify-content-center bg-white order-2 order-md-1">
            <div class="w-100 p-4 p-md-5" style="max-width: 450px;">

                <div class="mb-5">
                    <h1 class="fw-bold display-5 text-dark">Tekrar Hoşgeldin!</h1>
                    <p class="text-muted">Kaldığın yerden devam etmeye hazır mısın?</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control rounded-3 bg-light border-0" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-muted">E-posta</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control rounded-3 bg-light border-0" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="text-muted">Şifre</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label text-muted small" asp-for="Input.RememberMe">Beni Hatırla</label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small text-primary fw-bold">Şifreni mi unuttun?</a>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill py-3 fw-bold shadow-sm">
                        GİRİŞ YAP
                    </button>

                    <div class="text-center mt-5">
                        <p class="text-muted small">Hesabın yok mu? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold text-primary">Hemen Kayıt Ol</a></p>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-6 col-lg-7 d-none d-md-block p-0 position-relative order-1 order-md-2">
            <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2000&auto=format&fit=crop"
                 alt="Login Bg"
                 class="w-100 h-100"
                 style="object-fit: cover; filter: brightness(0.8);">

            <div class="position-absolute bottom-0 start-0 p-5 text-white" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                <h3 class="fw-bold">Hedefine Odaklan.</h3>
                <p class="mb-0 opacity-75">"Başarı tesadüf değildir. Çok çalışmak, azim ve öğrenmektir."</p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} *@