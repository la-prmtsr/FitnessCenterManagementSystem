@model FitnessCenterManagementSystem.Models.Trainer

@{
    ViewData["Title"] = "Details";
}
<h1>Details</h1>

<div>
    <h4>Trainer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FullName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Expertise)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Expertise)
        </dd>

        <dt class="col-sm-2">
            Hizmet Alanı
        </dt>
        <dd class="col-sm-10">
            <span class="badge bg-info text-dark">
                @if (Model.Service != null)
                {
                    @Model.Service.Name
                }
                else
                {
                    <text>Atanmamış</text>
                }
            </span>
        </dd>

        <dt class="col-sm-2">
            Çalışma Günleri
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.WorkingDays))
            {
                @Model.WorkingDays
            }
            else
            {
                <span class="text-muted fst-italic">Gün seçilmemiş</span>
            }
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StartTime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StartTime)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EndTime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EndTime)
        </dd>
       
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
