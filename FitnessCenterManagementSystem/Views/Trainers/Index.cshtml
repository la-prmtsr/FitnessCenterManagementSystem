@model IEnumerable<FitnessCenterManagementSystem.Models.Trainer>

@{
    ViewData["Title"] = "Trainer";
}

<h1>Trainer</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Antrenör Ekle</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Ad Soyad</th>
            <th>Hizmet (Branş)</th>
            <th>Hakkında / Detay</th>
            <th>Çalışma Günleri</th>
            <th>Saatler</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">
                    @Html.DisplayFor(modelItem => item.FullName)
                </td>
                <td>
                    @if (item.Service != null)
                    {
                        <span class="badge bg-info text-dark">
                            @(string.IsNullOrEmpty(item.Service.Name) ? "İsimsiz Hizmet" : item.Service.Name)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Atanmamış</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Expertise)
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.WorkingDays))
                    {
                        <small>@item.WorkingDays</small>
                    }
                    else
                    {
                        <span class="text-muted small fst-italic">Gün Seçilmedi</span>
                    }
                </td>
                <td>
                    @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
