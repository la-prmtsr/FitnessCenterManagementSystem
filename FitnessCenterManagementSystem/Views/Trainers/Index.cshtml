@model IEnumerable<FitnessCenterManagementSystem.Models.Trainer>

@{
    ViewData["Title"] = "Trainer Management";
}

<div class="container py-5 px-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="badge bg-dark text-lime mb-2 px-3 py-2 rounded-pill fw-bold" style="background-color: var(--core-dark) !important; color: var(--core-lime) !important;">
                STAFF MANAGEMENT
            </span>
            <h2 class="fw-extrabold text-dark mb-0 display-6 text-uppercase fst-italic">Eğitmen Yönetimi</h2>
            <p class="text-muted mb-0">Antrenör kadrosunu, uzmanlık alanlarını ve çalışma saatlerini buradan düzenleyin.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 py-3 shadow-lg fw-bold rounded-pill text-uppercase ls-1">
                <i class="bi bi-person-plus-fill me-2"></i> Yeni Antrenör Ekle
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-5 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-uppercase small fw-extrabold text-muted ls-1">
                            <th class="ps-4 py-3">Eğitmen</th>
                            <th>Branş / Hizmet</th>
                            <th>Uzmanlık Alanı</th>
                            <th>Çalışma Takvimi</th>
                            <th class="pe-4 text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-dark text-lime d-flex align-items-center justify-content-center rounded-circle me-3 shadow-sm" style="width: 45px; height: 45px; background-color: var(--core-dark) !important; color: var(--core-lime) !important;">
                                            <i class="bi bi-person-vcard fs-5"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@Html.DisplayFor(modelItem => item.FullName)</span>
                                            <small class="text-muted">ID: #@item.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Service != null)
                                    {
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-bold">
                                            <i class="bi bi-tag-fill me-1 text-lime" style="color: var(--core-lime) !important;"></i>
                                            @(string.IsNullOrEmpty(item.Service.Name) ? "İsimsiz Hizmet" : item.Service.Name)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">Atanmamış</span>
                                    }
                                </td>
                                <td class="text-muted small" style="max-width: 200px;">
                                    @Html.DisplayFor(modelItem => item.Expertise)
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @if (!string.IsNullOrEmpty(item.WorkingDays))
                                        {
                                            <span class="small fw-bold text-dark"><i class="bi bi-calendar-week me-1"></i> @item.WorkingDays</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Gün Seçilmedi</span>
                                        }
                                        <span class="badge bg-dark bg-opacity-10 text-dark rounded-pill py-1 px-2 small w-fit-content" style="width: fit-content;">
                                            <i class="bi bi-clock me-1"></i> @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                                        </span>
                                    </div>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-dark px-3 border-end border-secondary" title="Düzenle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark px-3 border-end border-secondary" title="Detay">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-dark px-3 text-danger" title="Sil">
                                            <i class="bi bi-person-x-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-people display-1 d-block mb-3 opacity-25"></i>
                                    <h5 class="text-muted">Sistemde henüz kayıtlı eğitmen bulunmuyor.</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <a asp-controller="Admin" asp-action="Index" class="text-decoration-none text-muted fw-bold small text-uppercase">
            <i class="bi bi-arrow-left me-1"></i> Yönetici Dashboard'a Dön
        </a>
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 1px; }
    .fw-extrabold { font-weight: 800; }
    .table-hover tbody tr:hover {
        background-color: rgba(217, 255, 153, 0.05) !important;
        transition: background-color 0.3s ease;
    }
    .btn-group .btn-dark:hover {
        background-color: #333 !important;
        color: var(--core-lime) !important;
    }
    .w-fit-content { width: fit-content; }
</style>