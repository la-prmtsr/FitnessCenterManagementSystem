@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container-fluid py-5 mb-5" style="background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%); border-radius: 0 0 50px 50px;">
    <div class="container py-5">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill fw-bold">
                    🚀 Yeni Nesil Spor Deneyimi
                </span>
                <h1 class="display-4 fw-bold text-dark mb-3 lh-sm">
                    Next-Gen Fitness<br>
                    <span class="text-primary">Discover Your Strength.</span>
                </h1>
                <p class="lead text-muted mb-5">
                    Profesyonel eğitmenler ve kişiselleştirilmiş programlarla potansiyelini keşfet.
                    Sağlıklı yaşam yolculuğun burada başlıyor.
                </p>
                <div class="d-flex gap-3">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg px-5 shadow-sm">Hemen Başla</a>
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-lg px-5">Giriş Yap</a>
                    }
                    else
                    {
                        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-lg px-5 shadow-sm">📅 Randevu Al</a>
                    }
                </div>
            </div>

            <div class="col-lg-6 mt-5 mt-lg-0 text-center">
                <img src="https://images.unsplash.com/photo-1571902943202-507ec2618e8f?q=80&w=1000"
                     alt="Yoga Class"
                     class="img-fluid rounded-4 shadow-lg"
                     style="max-height: 500px;">
            </div>

        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 text-center p-4 border-0 shadow-sm bg-white">
                <div class="card-body">
                    <div class="fs-1 mb-3 text-primary bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3 class="h5 fw-bold mt-3">Uzman Kadro</h3>
                    <p class="text-muted small">Alanında sertifikalı, deneyimli eğitmenlerle birebir çalışma imkanı.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center p-4 border-0 shadow-sm bg-white">
                <div class="card-body">
                    <div class="fs-1 mb-3 text-primary bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle">
                        <i class="bi bi-heart-pulse"></i>
                    </div>
                    <h3 class="h5 fw-bold mt-3">Modern Teknoloji</h3>
                    <p class="text-muted small">Vücut analizi ve performans takibi için en yeni cihazlar.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center p-4 border-0 shadow-sm bg-white">
                <div class="card-body">
                    <div class="fs-1 mb-3 text-primary bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h3 class="h5 fw-bold mt-3">Kolay Randevu</h3>
                    <p class="text-muted small">Web üzerinden 7/24 dilediğiniz eğitmenden randevu alın.</p>
                </div>
            </div>
        </div>
    </div>
</div>



























