@model FitnessCenterManagementSystem.Models.GymSetting

@{
    ViewData["Title"] = "Salon Ayarları";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3>⚙️ Spor Salonu Çalışma Ayarları</h3>
        </div>
        <div class="card-body">

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Message
                </div>
            }

            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="OpenTime" class="control-label fw-bold">Açılış Saati</label>
                        <input asp-for="OpenTime" class="form-control" type="time" />
                        <span asp-validation-for="OpenTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CloseTime" class="control-label fw-bold">Kapanış Saati</label>
                        <input asp-for="CloseTime" class="form-control" type="time" />
                        <span asp-validation-for="CloseTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="OpenDays" class="control-label fw-bold">Açık Olduğu Günler</label>
                    <input asp-for="OpenDays" class="form-control" placeholder="Monday,Tuesday,Wednesday..." />
                    <small class="text-muted">Günleri İngilizce ve aralarına virgül koyarak yazınız. (Örn: Monday,Wednesday,Friday)</small>
                    <span asp-validation-for="OpenDays" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <input type="submit" value="Ayarları Kaydet" class="btn btn-success btn-lg" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Ana Sayfaya Dön</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}