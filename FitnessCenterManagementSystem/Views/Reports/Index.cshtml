@{
    ViewData["Title"] = "API Raporlama";
}

<div class="container mt-4">
    <h2 class="mb-4">📋 Sistem Raporları (REST API)</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Rapor Seçenekleri</h5>
            <p class="text-muted small">Bu butonlar doğrudan <b>GymApiController</b> üzerinden veri çeker.</p>

            <div class="d-flex gap-2">
                <button onclick="loadAllTrainers()" class="btn btn-primary">
                    <i class="bi bi-people-fill"></i> Tüm Hocalar
                </button>

                <button onclick="loadPilatesTrainers()" class="btn btn-success">
                    <i class="bi bi-filter"></i> Sadece Pilates
                </button>

                <button onclick="loadStats()" class="btn btn-danger">
                    <i class="bi bi-bar-chart"></i> Randevu Sayıları
                </button>
            </div>

            <div id="apiError" class="text-danger mt-2" style="display:none;"></div>
        </div>
    </div>

    <div id="resultsArea" style="display:none;">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <span id="tableTitle">Sonuçlar</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0" id="apiTable">
                    <thead class="table-light" id="dynamicHead">
                    </thead>
                    <tbody id="apiTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ORTAK FONKSİYON: Tabloyu temizle ve yükleniyor göster
        function prepareTable(title, headerHtml) {
            $("#resultsArea").show();
            $("#tableTitle").text(title);
            $("#dynamicHead").html(headerHtml);
            $("#apiError").hide();
            $("#apiTableBody").html('<tr><td colspan="5" class="text-center p-3"><span class="spinner-border text-primary"></span> Yükleniyor...</td></tr>');
        }

        // 1. TÜM HOCALARI GETİR
        function loadAllTrainers() {
            prepareTable("Tüm Antrenör Listesi",
                `<tr><th>ID</th><th>Ad Soyad</th><th>Hizmet</th><th>Çalışma Günleri</th><th>Uzmanlık</th></tr>`);

            $.ajax({
                url: '/api/GymApi/Trainers', // Senin Controller URL'in
                type: 'GET',
                success: function (data) {
                    fillTableStandard(data);
                },
                error: handleError
            });
        }

        // 2. SADECE PILATES (FİLTRE)
        function loadPilatesTrainers() {
            prepareTable("Pilates Eğitmenleri",
                `<tr><th>ID</th><th>Ad Soyad</th><th>Hizmet</th><th>Çalışma Günleri</th><th>Uzmanlık</th></tr>`);

            $.ajax({
                url: '/api/GymApi/TrainersByService/Pilates', // Filtreleme URL'i
                type: 'GET',
                success: function (data) {
                    fillTableStandard(data);
                },
                error: handleError
            });
        }

        // 3. İSTATİSTİKLER (EN ÇOK RANDEVU)
        function loadStats() {
            prepareTable("Eğitmen Performans Raporu",
                `<tr><th>ID</th><th>Ad Soyad</th><th>Hizmet</th><th class="text-center">Toplam Randevu</th></tr>`);

            $.ajax({
                url: '/api/GymApi/Stats', // Yeni eklediğimiz URL
                type: 'GET',
                success: function (data) {
                    var tbody = $("#apiTableBody");
                    tbody.empty();

                    $.each(data, function (i, item) {
                        // Count değerine göre renk (0 ise gri, varsa yeşil)
                        var badgeClass = item.totalAppointments > 0 ? "bg-success" : "bg-secondary";

                        var row = `<tr>
                                               <td>${item.id}</td>
                                               <td class="fw-bold">${item.fullName}</td>
                                               <td>${item.service}</td>
                                               <td class="text-center">
                                                    <span class="badge ${badgeClass} fs-6">${item.totalAppointments}</span>
                                               </td>
                                           </tr>`;
                        tbody.append(row);
                    });
                },
                error: handleError
            });
        }

        // YARDIMCI: Standart tabloyu doldurur (Code Reuse)
        function fillTableStandard(data) {
            var tbody = $("#apiTableBody");
            tbody.empty();

            if (data.length === 0) {
                tbody.html('<tr><td colspan="5" class="text-center text-muted">Kayıt bulunamadı.</td></tr>');
                return;
            }

            $.each(data, function (i, item) {
                // Senin API'den gelen veri yapısı: item.service (string)
                var row = `<tr>
                                       <td>${item.id}</td>
                                       <td class="fw-bold">${item.fullName}</td>
                                       <td><span class="badge bg-info text-dark">${item.service}</span></td>
                                       <td><small>${item.workingDays ? item.workingDays : "-"}</small></td>
                                       <td>${item.expertise ? item.expertise : "-"}</td>
                                   </tr>`;
                tbody.append(row);
            });
        }

        function handleError(xhr) {
            $("#apiTableBody").empty();
            $("#apiError").text("HATA: Veri çekilemedi. (" + xhr.status + " " + xhr.statusText + ")").show();
        }
    </script>
}