@model FitnessCenterManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Create";
}
<h1>Randevu Al</h1>

<h4>Appointment</h4>
<hr />
<div class="row">
    <div class="col-md-4">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <strong>⚠️ Hata Oluştu:</strong>
                <div asp-validation-summary="All" class="text-danger mb-0"></div>
            </div>
        }

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="AppointmentDate" class="control-label">Randevu Tarihi</label>
                <input asp-for="AppointmentDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ServiceId" class="control-label">Hizmet Seçiniz</label>
                <select asp-for="ServiceId" class="form-control" asp-items="ViewBag.ServiceId">
                    <option value="">-- Önce Hizmet Seçin --</option>
                </select>
                <span asp-validation-for="ServiceId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TrainerId" class="control-label">Antrenör Seçiniz</label>
                <select asp-for="TrainerId" class="form-control" asp-items="ViewBag.TrainerId" disabled>
                    <option value="">-- Önce Hizmet Seçiniz --</option>
                </select>
                <span asp-validation-for="TrainerId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Randevu Oluştur" class="btn btn-primary" />
            </div>
        </form>

        <div class="mt-3">
            <div asp-validation-summary="All" class="text-danger alert alert-light"></div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index">Listeye Dön</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            // Hizmet (Service) değiştiğinde çalışır
            $("#ServiceId").change(function () {
                var serviceId = $(this).val();
                var trainerDropdown = $("#TrainerId");

                // Önce Trainer listesini temizle
                trainerDropdown.empty();
                trainerDropdown.append('<option value="">-- Antrenör Seçiniz --</option>');
                trainerDropdown.prop("disabled", true); // Yüklenirken kilitle

                if (serviceId) {
                    // Controller'daki GetTrainersByService API'sine git
                    $.ajax({
                        url: '/Appointments/GetTrainersByService',
                        type: 'GET',
                        data: { serviceId: serviceId },
                        success: function (data) {
                            // Gelen verileri döngüyle ekle
                            $.each(data, function (i, trainer) {
                                trainerDropdown.append('<option value="' + trainer.id + '">' + trainer.fullName + '</option>');
                            });
                            trainerDropdown.prop("disabled", false); // Kilidi aç
                        },
                        error: function () {
                            alert("Antrenörler yüklenirken bir hata oluştu.");
                        }
                    });
                }
            });
        });
    </script>
}