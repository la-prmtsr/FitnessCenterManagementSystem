@model FitnessCenterManagementSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Yönetici Paneli</h2>
            <p class="text-muted mb-0">Hoşgeldin, salonun güncel durum özeti aşağıdadır.</p>
        </div>
        <div>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                📅 @DateTime.Now.ToString("dd MMMM yyyy, dddd")
            </span>
        </div>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 text-uppercase fw-bold">Toplam Üye</p>
                        <h3 class="fw-bold mb-0">@Model.TotalMembers</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-calendar-check-fill fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 text-uppercase fw-bold">Bugünkü Dersler</p>
                        <h3 class="fw-bold mb-0">@Model.TodaysAppointments</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-wallet-fill fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 text-uppercase fw-bold">Tahmini Kazanç</p>
                        <h3 class="fw-bold mb-0">@Model.TotalRevenue.ToString("C0")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-trophy-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-muted small mb-0 text-uppercase fw-bold">Ayın Hocası</p>
                        <h5 class="fw-bold mb-0 text-truncate" title="@Model.TopTrainerName">
                            @(!string.IsNullOrEmpty(Model.TopTrainerName) ? Model.TopTrainerName : "-")
                        </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-clock-history me-2"></i> Yaklaşan Randevular
                    </h5>
                    <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-light text-primary fw-bold rounded-pill px-3">
                        Tümünü Gör <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive p-3">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Tarih / Saat</th>
                                    <th>Hizmet</th>
                                    <th>Eğitmen</th>
                                    <th>Üye</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.UpcomingAppointments)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@item.AppointmentDate.ToString("dd MMM, HH:mm")</td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-2">
                                                @item.Service.Name
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light rounded-circle text-center me-2" style="width:30px; height:30px; line-height:30px;">
                                                    <i class="bi bi-person-fill text-muted"></i>
                                                </div>
                                                @item.Trainer.FullName
                                            </div>
                                        </td>
                                        <td>@item.Member.UserName</td>
                                        <td>
                                            @if (item.Status == "Confirmed" || item.Status == "Onaylı")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Onaylı</span>
                                            }
                                            else if (item.Status == "Pending" || item.Status == "Bekliyor")
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">Bekliyor</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">@item.Status</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (!Model.UpcomingAppointments.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bi bi-calendar-x display-4 d-block mb-3"></i>
                                                Henüz yaklaşan bir randevu yok.
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>